# ========================================================
# Apex Automated Outbound Voice AI Fee Collection System
# Environment Configuration Template
# ========================================================

# Telephony Provider Selection: twilio | plivo | browser | simulation
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (Recommended for personal/testing setups)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Plivo Credentials (For enterprise SIP setups)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+1234567890

# Public Tunnel / Webhook URL (e.g. ngrok or Cloudflare or TwiML Bin)
PUBLIC_WEBHOOK_URL=https://your-public-tunnel-url.com

# Optional: OpenAI API Key (For advanced NLP semantic extraction; system has built-in rule-based fallback)
OPENAI_API_KEY=

# Application Settings
PORT=8000
HOST=0.0.0.0
SIMULATION_MODE=false
CALLING_THROTTLE_SECONDS=5
